{
  "$schema": "https://huggingface.co/software-mansion/react-native-executorch-spec/resolve/main/config.schema.json",
  "model": "easyocr",
  "family": "easyocr",
  "capabilities": [
    "text-detection",
    "text-recognition"
  ],
  "backend": "coreml",
  "license": "apache-2.0",
  "variants": [
    {
      "file": "EasyOCR_korean_coreml.pte",
      "precision": "int8",
      "quantized": true,
      "default": true,
      "methods": {
        "detect": {
          "inputs": [
            {
              "shape": [
                1,
                3,
                1280,
                1280
              ],
              "dtype": "float32"
            }
          ],
          "outputs": [
            {
              "shape": [
                1,
                640,
                640,
                2
              ],
              "dtype": "float32"
            },
            {
              "shape": [
                1,
                32,
                640,
                640
              ],
              "dtype": "float32"
            }
          ]
        },
        "recognize": {
          "inputs": [
            {
              "shape": [
                1,
                3,
                64,
                512
              ],
              "dtype": "float32"
            }
          ],
          "outputs": [
            {
              "shape": [
                1,
                127,
                1009
              ],
              "dtype": "float32"
            }
          ]
        },
        "recognize_enum_shapes": {
          "inputs": [],
          "outputs": [
            {
              "shape": [
                1,
                4
              ],
              "dtype": "int32"
            }
          ]
        },
        "detect_enum_shapes": {
          "inputs": [],
          "outputs": [
            {
              "shape": [
                3,
                4
              ],
              "dtype": "int32"
            }
          ]
        }
      }
    }
  ]
}
