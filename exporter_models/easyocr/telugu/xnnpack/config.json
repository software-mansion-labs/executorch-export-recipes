            }
          ],
          "outputs": [
            {
              "shape": [
                1,
                -1,
                -1,
                2
              ],
              "dtype": "float32"
            }
          ]
        },
        "recognize": {
          "inputs": [
            {
              "shape": [
                1,
                3,
                64,
                512
              ],
              "dtype": "float32"
            }
          ],
          "outputs": [
            {
              "shape": [
                1,
                127,
                166
              ],
              "dtype": "float32"
            }
          ]
        }
      }
    }
  ]
}
