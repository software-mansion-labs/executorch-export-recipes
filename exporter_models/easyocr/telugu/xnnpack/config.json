{
  "$schema": "https://huggingface.co/software-mansion/react-native-executorch-spec/resolve/main/config.schema.json",
  "model": "easy_ocr",
  "family": "easyocr",
  "size": "telugu",
  "capabilities": [
    "text-detection",
    "text-recognition"
  ],
  "backend": "xnnpack",
  "license": "apache-2.0",
  "variants": [
    {
      "file": "easy_ocr_telugu_xnnpack_int8.pte",
      "precision": "int8",
      "quantized": true,
      "default": true,
      "size_bytes": 32759704,
      "methods": {
        "detect": {
          "inputs": [
            {
