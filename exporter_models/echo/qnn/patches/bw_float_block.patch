   Qnn_BlockwiseExpansion_t block_expansion_;
 };
 
+// Per-block float scale-offsets with a bit width (QNN_QUANTIZATION_ENCODING_BW_FLOAT_BLOCK): the HTP encoding for
+// 2/4/8-bit block-quantized weights under fp16 activations (blockwise expansion needs integer activations).
+class BwFloatBlockQuantizeParamsWrapper final : public QuantizeParamsWrapper {
+ public:
+  explicit BwFloatBlockQuantizeParamsWrapper(
+      std::uint32_t bitwidth,
+      std::vector<std::uint32_t> block_size,
+      std::vector<Qnn_FloatScaleOffset_t> scale_offsets)
+      : QuantizeParamsWrapper(
+            QNN_DEFINITION_DEFINED,
+            QNN_QUANTIZATION_ENCODING_BW_FLOAT_BLOCK),
+        bitwidth_(bitwidth),
+        block_size_(std::move(block_size)),
+        scale_offsets_(std::move(scale_offsets)) {}
+
+  BwFloatBlockQuantizeParamsWrapper(const BwFloatBlockQuantizeParamsWrapper& rhs)
+      : QuantizeParamsWrapper(
+            rhs.GetEncodingDefinition(),
+            rhs.GetQuantizationEncoding()),
+        bitwidth_(rhs.bitwidth_),
+        block_size_(rhs.block_size_),
+        scale_offsets_(rhs.scale_offsets_) {}
+
+  BwFloatBlockQuantizeParamsWrapper& operator=(
+      const BwFloatBlockQuantizeParamsWrapper& rhs) = delete;
+  BwFloatBlockQuantizeParamsWrapper& operator=(
+      BwFloatBlockQuantizeParamsWrapper&& rhs) = delete;
+
+  ~BwFloatBlockQuantizeParamsWrapper() override = default;
+
+  std::unique_ptr<QuantizeParamsWrapper> Clone() override {
+    return std::make_unique<BwFloatBlockQuantizeParamsWrapper>(*this);
+  }
+
+  Qnn_QuantizeParams_t CreateQuantizeParams() override {
+    Qnn_QuantizeParams_t rval;
+    rval.encodingDefinition = GetEncodingDefinition();
+    rval.quantizationEncoding = GetQuantizationEncoding();
+    rval.bwFloatBlockEncoding.bitwidth = bitwidth_;
+    rval.bwFloatBlockEncoding.blockSize = block_size_.data();
+    rval.bwFloatBlockEncoding.floatScaleOffset = scale_offsets_.data();
+    return rval;
+  }
+
+ private:
+  std::uint32_t bitwidth_;
+  std::vector<std::uint32_t> block_size_;
+  std::vector<Qnn_FloatScaleOffset_t> scale_offsets_;
+};
+
 // Factory function to create quantization param wrapper from QnnQuantization
 std::unique_ptr<QuantizeParamsWrapper> CreateQuantizationParamWrapper(
     const Qnn_Tensor_t& tensor);
