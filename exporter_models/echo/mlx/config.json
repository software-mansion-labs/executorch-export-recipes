            { "shape": [24, 1, 6, null, 128], "dtype": "float16" },
            { "shape": [24, 1, 6, null, 128], "dtype": "float16" }
          ],
          "outputs": [
            { "shape": [6, null], "dtype": "int64" }
          ]
        }
      }
    },
    {
      "file": "codec_decoder_mlx_fp32.pte",
      "precision": "fp32",
      "quantized": false,
      "default": true,
      "methods": {
        "decode": {
          "inputs": [
            { "shape": [8, null], "dtype": "int64" }
