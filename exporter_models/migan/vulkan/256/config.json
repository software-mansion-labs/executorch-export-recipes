{
  "$schema": "https://huggingface.co/software-mansion/react-native-executorch-spec/resolve/main/config.schema.json",
  "model": "migan",
  "family": "migan",
  "capabilities": [
    "image-inpainting"
  ],
  "backend": "vulkan",
  "license": "mit",
  "variants": [
    {
      "file": "migan_256_vulkan_fp16.pte",
      "precision": "fp16",
      "quantized": false,
      "default": true,
      "methods": {
        "forward": {
          "inputs": [
            {
              "name": "image",
              "shape": [
                1,
                3,
                256,
                256
              ],
              "dtype": "float32"
            },
            {
              "name": "mask",
              "shape": [
                1,
                1,
                256,
                256
              ],
              "dtype": "float32"
            }
          ],
          "outputs": [
            {
              "name": "image",
              "shape": [
                1,
                3,
                256,
                256
              ],
              "dtype": "float32"
            }
          ]
        }
      }
    }
  ]
}
