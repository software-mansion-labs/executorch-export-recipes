{
  "$schema": "https://huggingface.co/software-mansion/react-native-executorch-spec/resolve/main/config.schema.json",
  "model": "eurollm",
  "family": "llama",
  "size": "1_7b",
  "capabilities": [
    "text-generation",
    "translation"
  ],
  "backend": "mlx",
  "license": "apache-2.0",
  "tokenizer": "tokenizer.json",
  "tokenizer_config": "tokenizer_config.json",
  "variants": [
    {
      "file": "eurollm_1_7b_mlx_int8.pte",
      "precision": "8w",
      "quantized": true,
      "default": true,
      "methods": {
        "enable_dynamic_shape": true,
        "forward": {
          "inputs": [
            {
              "shape": [
                1,
                {
                  "min": 1,
                  "max": 1023
                }
              ],
              "dtype": "int64"
            },
            {
              "shape": [
                1
              ],
              "dtype": "int64"
            }
          ],
          "outputs": [
            {
              "shape": [
                1,
                128000
              ],
              "dtype": "bfloat16"
            }
          ]
        },
        "get_bos_id": 1,
        "get_eos_ids": [
          4,
          2
        ],
        "get_max_context_len": 1024,
        "get_max_seq_len": 1024,
        "get_n_layers": 24,
        "get_vocab_size": 128000,
        "use_kv_cache": true,
        "use_sdpa_with_kv_cache": true
      }
    }
  ]
}
