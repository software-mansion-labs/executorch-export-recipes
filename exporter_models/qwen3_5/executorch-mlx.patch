diff --git a/backends/mlx/partitioner.py b/backends/mlx/partitioner.py
index 0896cafc3..cffb74f4a 100644
--- a/backends/mlx/partitioner.py
+++ b/backends/mlx/partitioner.py
@@ -291,6 +291,22 @@ class MLXPartitioner(Partitioner):
             # Tag mutated buffers so they are included in the partition
             # This ensures the partitioned subgraph has proper mutation tracking
             tag_mutated_buffer(edge_program)
+            # A mutable buffer crossing control-flow/partition boundaries must
+            # remain runtime-owned, along with the copy that updates it.
+            buffers = edge_program.graph_signature.inputs_to_buffers
+            mutations = edge_program.graph_signature.buffers_to_mutate
+            nodes = {node.name: node for node in edge_program.graph.nodes}
+            for name, target in mutations.items():
+                buffer = next(
+                    node
+                    for node in edge_program.graph.nodes
+                    if buffers.get(node.name) == target
+                )
+                tags = {user.meta.get("delegation_tag") for user in buffer.users}
+                tag = buffer.meta.get("delegation_tag")
+                if tags != {tag} or nodes[name].meta.get("delegation_tag") != tag:
+                    buffer.meta.pop("delegation_tag", None)
+                    nodes[name].meta.pop("delegation_tag", None)
 
         return PartitionResult(
             tagged_exported_program=edge_program,
