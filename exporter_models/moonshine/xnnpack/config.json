{
  "$schema": "https://huggingface.co/software-mansion/react-native-executorch-spec/resolve/main/config.schema.json",
  "model": "moonshine",
  "family": "moonshine",
  "capabilities": ["speech-to-text"],
  "backend": "xnnpack",
  "license": "mit",
  "variants": [
    {
      "file": "moonshine_tiny_xnnpack_encoder.pte",
      "precision": "fp32", "quantized": false, "default": true,
      "methods": {"forward": {
        "inputs": [{"shape": [1, 480000], "dtype": "float32"}],
        "outputs": [{"shape": [1, 1248, 288], "dtype": "float32"}]
      }}
    },
    {
      "file": "moonshine_tiny_xnnpack_decoder.pte",
      "precision": "fp32", "quantized": false, "default": false,
      "methods": {"forward": {
        "inputs": [
          {"shape": [1, 178], "dtype": "int64"},
          {"shape": [1, 1248, 288], "dtype": "float32"}
        ],
        "outputs": [{"shape": [1, 179], "dtype": "int64"}]
      }}
    }
  ]
}
