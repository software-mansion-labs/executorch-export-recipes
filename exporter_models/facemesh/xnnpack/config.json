{
  "$schema": "https://huggingface.co/software-mansion/react-native-executorch-spec/resolve/main/config.schema.json",
  "model": "facemesh",
  "family": "facemesh",
  "capabilities": [
    "object-detection"
  ],
  "backend": "xnnpack",
  "license": "apache-2.0",
  "variants": [
    {
      "file": "facemesh_xnnpack_fp32.pte",
      "precision": "fp32",
      "quantized": false,
      "default": true,
      "methods": {
        "forward": {
          "inputs": [
            {
              "shape": [
                1,
                3,
                192,
                192
              ],
              "dtype": "float32"
            }
          ],
          "outputs": [
            {
              "name": "boxes",
              "shape": [
                1,
                4
              ],
              "dtype": "float32"
            },
            {
              "name": "scores",
              "shape": [
                1
              ],
              "dtype": "float32"
            },
            {
              "name": "keypoints",
              "shape": [
                1,
                468,
                4
              ],
              "dtype": "float32"
            }
          ]
        }
      }
    }
  ]
}
