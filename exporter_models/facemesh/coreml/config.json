{
  "$schema": "https://huggingface.co/software-mansion/react-native-executorch-spec/resolve/main/config.schema.json",
  "model": "facemesh",
  "family": "facemesh",
  "capabilities": ["object-detection"],
  "backend": "coreml",
  "license": "apache-2.0",
  "variants": [
    {
      "file": "facemesh_coreml_fp16.pte",
      "precision": "fp16",
      "quantized": false,
      "default": true,
      "methods": {
        "forward": {
          "inputs": [{ "shape": [1, 3, 192, 192], "dtype": "float32" }],
          "outputs": [
            { "name": "landmarks", "shape": [468, 3], "dtype": "float32" },
            { "name": "score", "shape": [1], "dtype": "float32" }
          ]
        }
      }
    }
  ]
}
