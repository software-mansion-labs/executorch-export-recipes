{
  "$schema": "https://huggingface.co/software-mansion/react-native-executorch-spec/resolve/main/config.schema.json",
  "model": "paddleocr_layout",
  "family": "paddleocr_layout",
  "capabilities": [
    "object-detection"
  ],
  "backend": "coreml",
  "license": "apache-2.0",
  "variants": [
    {
      "file": "PP-DocLayoutV3_coreml.pte",
      "precision": "fp16",
      "quantized": false,
      "default": true,
      "methods": {
        "forward": {
          "inputs": [
            { "shape": [1, 3, 800, 800], "dtype": "float32" }
          ],
          "outputs": [
            { "shape": [300, 4], "dtype": "float32" },
            { "shape": [300], "dtype": "float32" },
            { "shape": [300], "dtype": "float32" }
          ]
        }
      }
    }
  ]
}
