{
  "$schema": "https://huggingface.co/software-mansion/react-native-executorch-spec/resolve/main/config.schema.json",
  "model": "paddleocr",
  "family": "paddleocr",
  "capabilities": [
    "text-detection",
    "text-recognition"
  ],
  "backend": "xnnpack",
  "license": "apache-2.0",
  "variants": [
    {
      "file": "PP-OCRv6_xnnpack.pte",
      "precision": "fp32",
      "quantized": false,
      "default": true,
      "methods": {
        "detect": {
          "inputs": [
            {
              "shape": [
                1,
                3,
                1280,
                1280
              ],
              "dtype": "float32"
            }
          ],
          "outputs": [
            {
              "shape": [
                1,
                1,
                1280,
                1280
              ],
              "dtype": "float32"
            }
          ]
        },
        "recognize": {
          "inputs": [
            {
              "shape": [
                1,
                3,
                48,
                1280
              ],
              "dtype": "float32"
            }
          ],
          "outputs": [
            {
              "shape": [
                1,
                160,
                18710
              ],
              "dtype": "float32"
            }
          ]
        },
        "get_dynamic_dims_detect": {
          "inputs": [],
          "outputs": [
            {
              "shape": [
                4,
                3
              ],
              "dtype": "int32"
            }
          ]
        },
        "get_dynamic_dims_recognize": {
          "inputs": [],
          "outputs": [
            {
              "shape": [
                4,
                3
              ],
              "dtype": "int32"
            }
          ]
        }
      }
    }
  ]
}
