{
  "$schema": "https://huggingface.co/software-mansion/react-native-executorch-spec/resolve/main/config.schema.json",
  "source": "sentence-transformers/distiluse-base-multilingual-cased-v2",
  "model": "distiluse_base_multilingual_cased_v2",
  "capabilities": ["text-embedding"],
  "backend": "xnnpack",
  "license": "apache-2.0",
  "variants": [
    {
      "file": "distiluse_base_multilingual_cased_v2_xnnpack_fp32.pte",
      "precision": "fp32",
      "quantized": false,
      "default": true,
      "methods": {
        "forward": {
          "inputs": [
            { "shape": [1, 126], "dtype": "int64" },
            { "shape": [1, 126], "dtype": "int64" }
          ],
          "outputs": [{ "shape": [1, 512], "dtype": "float32" }]
        }
      }
    }
  ]
}
