{
  "$schema": "https://huggingface.co/software-mansion/react-native-executorch-spec/resolve/main/config.schema.json",
  "source": "LiquidAI/LFM2.5-VL-450M",
  "model": "lfm2_5_vl_450m",
  "capabilities": ["vision-language"],
  "backend": "xnnpack",
  "license": "lfm-1.0",
  "variants": [
    {
      "file": "lfm2_5_vl_450m_xnnpack.pte",
      "precision": "8da4w",
      "quantized": true,
      "default": true,
      "runtimeVerifiable": false,
      "methods": {
        "vision_encoder": {
          "inputs": [{"shape": [1, 3, 512, 512], "dtype": "float32"}],
          "outputs": [{"shape": [1, 256, 1024], "dtype": "float32"}]
        },
        "token_embedding": {
          "inputs": [{"shape": [1, 2048], "dtype": "int64"}],
          "outputs": [{"shape": [1, 2048, 1024], "dtype": "float32"}]
        },
        "text_decoder": {
          "inputs": [
            {"shape": [1, 2048, 1024], "dtype": "float32"},
            {"shape": [2048], "dtype": "int64"}
          ],
          "outputs": [{"shape": [1, 65536], "dtype": "float32"}]
        }
      }
    }
  ]
}
