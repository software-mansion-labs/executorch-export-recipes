{
  "$schema": "https://huggingface.co/software-mansion/react-native-executorch-spec/resolve/main/config.schema.json",
  "model": "efficientnet_v2_s",
  "family": "efficientnet",
  "capabilities": [
    "classification"
  ],
  "backend": "mlx",
  "license": "bsd-3-clause",
  "variants": [
    {
      "file": "efficientnet_v2_s_mlx_fp16.pte",
      "precision": "fp16",
      "quantized": false,
      "default": true,
      "methods": {
        "forward": {
          "inputs": [
            {
              "shape": [
                1,
                3,
                384,
                384
              ],
              "dtype": "float32"
            }
          ],
          "outputs": [
            {
              "shape": [
                1,
                1000
              ],
              "dtype": "float32"
            }
          ]
        }
      }
    }
  ]
}
